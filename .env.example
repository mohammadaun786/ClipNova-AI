# ClipNova AI - Environment Configuration

# AI Integrations (Whisper & Metadata)
# Gemini API Key (recommended for multimodal captions & viral metadata)
GEMINI_API_KEY=
# OpenAI API Key (for Whisper-1 transcription & GPT-4o-mini metadata)
OPENAI_API_KEY=

# YouTube Data API v3 (OAuth2 Credentials)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/publish/youtube/callback

# Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# Server Configuration
SERVER_HOST=http://localhost:8000
